
# Contact forms: provision both keys and exact hostnames to activate Turnstile.
# Blank keys leave Turnstile inactive; honeypots still apply.
# TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated bare hostnames, e.g. example.dk,www.example.dk
TURNSTILE_HOSTNAMES=
# Explicit provider: altcha, cap, turnstile, or none. Unset preserves legacy settings.
# Each customer/environment/contact surface requires an independent site key.
# CONTACT_SPAM_PROVIDER=altcha
ALTCHA_SITE_KEY=
ALTCHA_SECRET_KEY=
# Server-only origin, e.g. http://altcha.contact-altcha.svc.cluster.local:3001
ALTCHA_VERIFY_BASE_URL=
# Browser-reachable HTTPS origin, e.g. https://altcha.scaledev.dk
ALTCHA_PUBLIC_BASE_URL=

# Optional compatible self-hosted Cap provider.
CAP_SITE_KEY=
CAP_SECRET_KEY=
CAP_VERIFY_BASE_URL=
CAP_PUBLIC_BASE_URL=
